# Supabase (deixe vazio para rodar em modo demonstração, sem login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Link do botão de suporte (ex.: https://wa.me/5574999999999)
NEXT_PUBLIC_SUPORTE_URL=

# ---------------------------------------------------------------------------
# Somente no servidor (nunca use NEXT_PUBLIC_ nestes)
# ---------------------------------------------------------------------------
# Chave de serviço do Supabase: usada pelos webhooks (iFood, aiqfome, Pix)
SUPABASE_SERVICE_ROLE_KEY=

# Pix dinâmico com baixa automática (Mercado Pago, Efí, Asaas...)
PIX_PROVEDOR=

# iFood (Portal do Desenvolvedor > app > credenciais)
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# aiqfome (segredo do webhook)
AIQFOME_WEBHOOK_SECRET=

# Stone (maquininha integrada)
STONE_URL=
STONE_CLIENT_ID=
STONE_CLIENT_SECRET=

# NFC-e pelo Focus NFe
FOCUS_NFE_TOKEN=

# WhatsApp Business (Cloud API da Meta) para o chatbot
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Endereço público do sistema (links enviados pelo chatbot), ex.: https://carlosbar.vercel.app
NEXT_PUBLIC_SITE_URL=
